# Self-hosted Umami (cookiefrei). Ohne beide Werte wird KEIN Analytics-Skript
# geladen (lokal daher bewusst leer lassen). Dieselbe App laeuft unter
# ahommrich.de und hommri.ch -> EINE Website-ID trackt beide Domains, im
# Umami-Dashboard nach Hostname filterbar.
# CSP wird hier nicht gesetzt (keine vorhanden), daher reicht ein Rebuild+Deploy.
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_API_HOST=https://analytics.hommrich.app

# Kontaktformular -> zentraler hommrich-hub (Zustellung via Brevo). Werte aus dem Hub-Panel.
# Fehlt eine der drei Variablen (z. B. lokal), wird die Anfrage neutral als „simuliert"
# bestaetigt und NICHT versendet -> Formular ist ohne Hub testbar.
HUB_URL=https://hub.hommrich.app
HUB_SITE_SLUG=hommri-ch
HUB_KEY=
